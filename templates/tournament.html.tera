{% import "partials" as partials %}
<!doctype html>
<html lang="ca">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <meta name="color-scheme" content="light dark"/>
        <title>{{ tournament.name }} | Gestruc</title>

        <link rel="stylesheet" href="/main.css"/>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
        <link rel="favicon" type="image/png" sizes="32x32" href="/favicon.png"/>
	</head>
	<body>
		<h1>{{ tournament.name }}</h1>
        <p>{{ tournament.edition }}</p>

        <h2>Equips</h2>

        {%- if team_infos %}
        <div class="card-stack">
            {%- for team in team_infos %}
            <a href="/teams/{{ team.team.id }}"><div class="card team-card">
                <h2>{{ team.team.name }}</h2>
                <p><strong>{{ team.captain.name }}</strong>, {{ team.partner.name }}</p>
            </div></a>
            {%- endfor %}
        </div>
        {%- else %}
        <p>No hi ha cap equip registrat</p>
        {%- endif %}

        <h2>Partides</h2>
        {%- if games %}
        <div class="card-stack">
            {%- for game in games %}
                {{ partials::game_card(game=game) }}
            {%- endfor %}
        </div>
        {%- else %}
        <p>No hi ha cap partida enregistrada</p>
        {%- endif %}
    </body>
</html>
