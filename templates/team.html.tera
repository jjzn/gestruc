<!doctype html>
<html lang="ca">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <meta name="color-scheme" content="light dark"/>
        <title>{{ team.name }} | Gestruc</title>

        <link rel="stylesheet" href="/main.css"/>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
        <link rel="favicon" type="image/png" sizes="32x32" href="/favicon.png"/>
	</head>
	<body>
		<h1>{{ team.name }}</h1>

        <div class="stack-horiz">
            <p>{{ team.tournament_name }} ({{ team.tournament_year }})<br/><strong>{{ captain.name }}</strong>, {{ partner.name }}</p>
            <a href="/games/add" class="btn">Afegir partida</a>
        </div>

        {%- if games %}
            {%- for game in games %}
        <div class="game-card">
            <h2><a href="/teams/{{ game.team_ids.0 }}">{{ game.team_names.0 }}</a> vs <a href="/teams/{{ game.team_ids.1 }}">{{ game.team_names.1 }}</a></h2>
            <p class="date">{{ game.date | date(format="%Y-%m-%d %H:%M", timezone="Europe/Madrid")}}</p>
            <p class="scores">{{ game.scores.0.0 }}-{{ game.scores.1.0 }}, {{ game.scores.0.1 }}-{{ game.scores.1.1 }}, {{ game.scores.0.2 }}-{{ game.scores.1.2 }}</p>
            <ul>
            {%- if game.accepted.0 %}
                <li>{{ game.team_names.0 }}: resultat acceptat {{ game.accepted.0 | date(format="%Y-%m-%d %H:%M", timezone="Europe/Madrid") }}</li>
            {%- else %}
                <li>{{ game.team_names.0 }}: resultat encara no acceptat</li>
            {%- endif %}
            {%- if game.accepted.1 %}
                <li>{{ game.team_names.1 }}: resultat acceptat {{ game.accepted.1 | date(format="%Y-%m-%d %H:%M", timezone="Europe/Madrid") }}</li>
            {%- else %}
                <li>{{ game.team_names.1 }}: resultat encara no acceptat</li>
            {%- endif %}
            </ul>
        </div>
            {%- endfor %}
        {%- else %}
        <p>No tens partides jugades</p>
        {%- endif %}
    </body>
</html>
