<!doctype html>
<html lang="ca">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <meta name="color-scheme" content="light dark"/>
        <title>Gestruc</title>

        <link rel="stylesheet" href="/main.css"/>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
        <link rel="favicon" type="image/png" sizes="32x32" href="/favicon.png"/>
	</head>
	<body>
		<h1>{{ team.name }}</h1>
        <p>{{ team.tournament_name }} ({{ team.tournament_year }})</p>
        <p><strong>{{ captain.name }}</strong>, {{ partner.name }}</p>
        {%- if games %}
            {%- for game in games %}
        <a href="/games/"><div class="game-card">
        </div></a>
            {%- endfor %}
        {%- else %}
        <p>No tens partides jugades</p>
        {%- endif %}
    </body>
</html>
